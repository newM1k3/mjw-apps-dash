# ImmersiveKit Dashboard (mjw-apps-dash) — environment variables
# Copy this file to `.env` and fill in real values. All vars are build-time
# (Vite inlines anything prefixed VITE_ into the client bundle — never put
# secrets here).
#
# Tool URLs are optional — if unset, toolUrls.ts falls back to the
# .netlify.app URL. Set these to the permanent custom domain in production.

# ── Platform ────────────────────────────────────────────────────────────────
VITE_POCKETBASE_URL=https://immersive-kit.pockethost.io
VITE_PLATFORM_GATEWAY_URL=
VITE_STRIPE_UPGRADE_URL=

# ── Onboarding ───────────────────────────────────────────────────────────────
VITE_VENUE_INTELLIGENCE_WIZARD_URL=https://setup.immersivekit.ca

# ── Feature flags ─────────────────────────────────────────────────────────────
# Set to "false" to enforce per-tool requiredTier. When true, all signed-in
# users can launch every tool regardless of tier (beta all-access).
VITE_ENABLE_BETA_ALL_ACCESS=true

# ── Tool URLs ─────────────────────────────────────────────────────────────────
# Design suite
VITE_LOCK_MAPPING_STUDIO_URL=https://lockmap.immersivekit.ca
VITE_PUZZLE_DEPENDENCY_AUDITOR_URL=https://puzzleaudit.immersivekit.ca
VITE_ROOM_LAYOUT_RISK_MAPPER_URL=https://layout.immersivekit.ca
VITE_PUZZLE_FLOW_VISUALIZER_URL=https://flow.immersivekit.ca
VITE_PRODUCTION_BIBLE_BUILDER_URL=https://blueprint.immersivekit.ca
VITE_AI_ESCAPE_ROOM_GENERATOR_URL=https://roomgen.immersivekit.ca

# Operations suite
VITE_ROOMREADY_OPS_URL=https://roomready.immersivekit.ca
VITE_GM_SCRIPT_LIBRARY_URL=https://scripts.immersivekit.ca
VITE_PARTY_PROFIT_PLANNER_URL=https://parties.immersivekit.ca
VITE_CORPORATE_PROPOSAL_GENERATOR_URL=https://corporate.immersivekit.ca

# Marketing suite
VITE_MARKETING_PLAYBOOK_GENERATOR_URL=https://playbook.immersivekit.ca
VITE_MARKETING_AUDIT_TOOL_URL=https://mktaudit.immersivekit.ca
VITE_REVIEW_SCORECARD_ANALYZER_URL=https://reviews.immersivekit.ca
VITE_SEASONAL_CAMPAIGN_BUILDER_URL=https://campaigns.immersivekit.ca
VITE_SCHEMA_MARKUP_GENERATOR_URL=https://schema.immersivekit.ca
VITE_CONTENT_OS_MASTERMIND_URL=https://mastermind.immersivekit.ca

# =============================================================================
# mjw-apps-dash — Environment Variable Reference
# =============================================================================
# Copy this file to .env and fill in your real values before running locally
# or deploying to Netlify.
#
#   cp .env.example .env
#
# IMPORTANT:
#   - .env is listed in .gitignore and must NEVER be committed to the repo.
#   - All variables prefixed with VITE_ are exposed to the browser bundle.
#     Do NOT put secrets (API keys, private tokens) in VITE_ variables.
#   - Variables without VITE_ are server/build-time only (e.g. NODE_VERSION).
# =============================================================================


# -----------------------------------------------------------------------------
# 1. PocketBase — Authentication & Data Backend
# -----------------------------------------------------------------------------
# The base URL of your PocketBase instance.
# Used by src/lib/pocketbase.ts for auth and user-tier lookups.
# Example: https://mjw-pb.fly.dev  or  http://localhost:8090 (local dev)
VITE_POCKETBASE_URL=


# -----------------------------------------------------------------------------
# 2. Feature Flags
# -----------------------------------------------------------------------------
# Beta all-access mode.
# When absent OR set to anything other than "false", ALL authenticated users
# can launch ALL 15 tools regardless of their subscription tier.
#
# ⚠️  MUST be explicitly set to "false" in production to enforce tier gating.
# See: src/lib/beta.ts
#
# Allowed values: "true" | "false"
VITE_ENABLE_BETA_ALL_ACCESS=false


# -----------------------------------------------------------------------------
# 3. Monetisation — Stripe Upgrade Flow
# -----------------------------------------------------------------------------
# The URL users are sent to when they click an upgrade CTA.
# This is typically a Stripe Payment Link or Customer Portal URL.
# See: src/pages/UpgradePrompt.tsx
VITE_STRIPE_UPGRADE_URL=


# -----------------------------------------------------------------------------
# 4. Platform Gateway (Future — optional)
# -----------------------------------------------------------------------------
# Base URL for the MJW Global Auth & Credits Gateway (e.g. auth.mjw.app).
# Leave blank to disable gateway mode — PocketBase auth continues unchanged.
# When set to a valid http/https URL, isGatewayEnabled() returns true.
# See: src/lib/platformGateway.ts
VITE_PLATFORM_GATEWAY_URL=


# -----------------------------------------------------------------------------
# 5. Tool URLs — Design Suite
# -----------------------------------------------------------------------------
# Permanent production URLs for each tool in the Design suite.
# If a variable is set, it takes precedence over the temporary fallback URL
# in src/config/toolUrls.ts. Leave blank to use the temporary fallback.
# See: src/config/toolUrls.ts → getToolUrl()

# Lock Mapping Studio
VITE_LOCK_MAPPING_STUDIO_URL=

# Puzzle Dependency Auditor
VITE_PUZZLE_DEPENDENCY_AUDITOR_URL=

# Room Layout Risk Mapper
VITE_ROOM_LAYOUT_RISK_MAPPER_URL=

# Puzzle Flow Visualizer
VITE_PUZZLE_FLOW_VISUALIZER_URL=

# Production Bible Builder (Immersive Production Bible Builder)
VITE_PRODUCTION_BIBLE_BUILDER_URL=

# AI Escape Room Generator
VITE_AI_ESCAPE_ROOM_GENERATOR_URL=


# -----------------------------------------------------------------------------
# 6. Tool URLs — Operations Suite
# -----------------------------------------------------------------------------

# RoomReady Ops
VITE_ROOMREADY_OPS_URL=

# GM Script Library
VITE_GM_SCRIPT_LIBRARY_URL=

# Party Profit Planner
VITE_PARTY_PROFIT_PLANNER_URL=


# -----------------------------------------------------------------------------
# 7. Tool URLs — Marketing Suite
# -----------------------------------------------------------------------------

# Marketing Playbook Generator
VITE_MARKETING_PLAYBOOK_GENERATOR_URL=

# Marketing Audit Tool
VITE_MARKETING_AUDIT_TOOL_URL=

# Review Scorecard Analyzer
VITE_REVIEW_SCORECARD_ANALYZER_URL=

# Seasonal Campaign Builder
VITE_SEASONAL_CAMPAIGN_BUILDER_URL=

# Schema Markup Generator
VITE_SCHEMA_MARKUP_GENERATOR_URL=

# Content OS — Mastermind Add-on
# This tool has no temporary fallback URL. Leave blank until a permanent
# deployment URL is available, or set a staging URL for internal testing.
VITE_CONTENT_OS_MASTERMIND_URL=
